# Copy to .env and fill in. See DEPLOY.md for hosting.

# Database — PostgreSQL. Local dev: use the Docker Postgres from
# docker-compose.yml (below) or any Postgres URL. Prod (Railway): reference the
# managed Postgres, e.g. set DATABASE_URL to ${{Postgres.DATABASE_URL}}.
# See POSTGRES.md for the one-time migration setup.
DATABASE_URL=postgresql://holicruit:holicruit@localhost:5432/holicruit?schema=public

# NextAuth v5 — generate one with: npx auth secret
AUTH_SECRET=

# NextAuth's canonical URL. Production MUST be https://app.holicruit.com —
# if unset/wrong, /api/auth/providers advertises e.g. https://localhost:8080
# and absolute-URL auth flows (redirects, future OAuth) break.
AUTH_URL=http://localhost:3000

# One-click demo logins on /login + the "demo" banner on the marketing pages.
# Explicit opt-in: shown ONLY when set to 1. Leave unset in production unless a
# public demo (with fictional @holicruit.test accounts) is intended.
# Build-time variable (NEXT_PUBLIC_*): changing it needs a rebuild/redeploy.
NEXT_PUBLIC_DEMO_LOGINS=1

# Admin inbox (/feedback: feedback, leads, signups). Comma-separated; NO default
# (unset = nobody). Only list addresses whose account already exists and is yours.
ADMIN_EMAILS=

# Seed safety (prisma/seed.ts). Never set these permanently. To wipe and reseed
# a non-local database you need BOTH; remove both right after the deploy.
# SEED_FORCE=1
# SEED_FORCE_CONFIRM=wipe-production

# The app's public URL (used for links/callbacks). Local default below.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (TEST mode). Leave blank to run billing in stub mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Firecrawl — renders JS + bypasses bot-blocks for URL job-ad import.
# Free key at https://firecrawl.dev . Without it, URL import falls back to a
# plain fetch (works for simple pages; big job boards need this key or paste).
FIRECRAWL_API_KEY=
