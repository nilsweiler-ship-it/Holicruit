// Holicruit data model — built around the fit model and opt-in matching.
// Enums and JSON payloads are stored as Strings (JSON-encoded where noted) so
// the model stays portable; helpers in src/lib/db serialize/parse them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Identity ──────────────────────────────────────────────────────────────

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String
  initials     String
  // Privacy: an optional public alias. When `anonymous` is on, counterparties
  // see the alias instead of the real name until the user explicitly reveals
  // themselves for a specific match. Real name/contact stay private meanwhile.
  alias        String?
  anonymous    Boolean @default(false)
  // JSON array of hats the user holds: "candidate" | "hiring_manager" | "recruiter" | "provider"
  roles        String  @default("[\"candidate\"]")
  createdAt    DateTime @default(now())

  candidate     CandidateProfile?
  provider      Provider?
  companies     Company[]
  intros        RecruiterIntro[]
  subscriptions Subscription[]
  sentMessages  Message[]
  feedback      ProductFeedback[]
}

// Low-barrier product feedback from anyone using the app. Backs the "best
// hiring tool" pledge — every submission lands in the in-app feedback inbox.
model ProductFeedback {
  id        String   @id @default(cuid())
  message   String   @default("")
  sentiment String? // "great" | "ok" | "bad"
  path      String? // page it was sent from
  role      String? // persona at submit time
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ── Candidate ─────────────────────────────────────────────────────────────

model CandidateProfile {
  id                String  @id @default(cuid())
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String  @unique
  headline          String
  industry          String
  completeness      Int     @default(40)
  scenarioCompleted Boolean @default(false)
  // JSON map of Big Five + Integrity levels (0–100), measured from the scenario.
  traitProfile      String?
  // Uploaded profile photo, stored as a data URL (demo). Optional.
  avatarUrl         String?
  // Import-your-pipeline: a candidate an HM imported is "unclaimed" — visible
  // only in that HM's pipeline (never the wider marketplace) until the person
  // accepts the invite and claims the profile. Then claimed flips to true.
  claimed           Boolean @default(true)
  invitedByUserId   String?
  inviteToken       String? @unique

  hardSkills   HardSkill[]
  softSkills   SoftSkillScore[]
  endorsements Endorsement[]
  matches      Match[]
  enrollments  Enrollment[]
  scenarioRuns ScenarioResult[]
}

model HardSkill {
  id        String           @id @default(cuid())
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  name      String
  verified  Boolean          @default(false)
  // Applied skill-check score (0–100), when the candidate passed a work-sample quiz.
  assessedScore Int?

  @@unique([profileId, name])
}

model SoftSkillScore {
  id        String           @id @default(cuid())
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  name      String
  level     Int

  @@unique([profileId, name])
}

model Endorsement {
  id              String           @id @default(cuid())
  profile         CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId       String
  skill           String
  endorserName    String
  endorserInitials String
  endorserHeadline String
  relationship    String
  createdAt       DateTime         @default(now())
}

model ScenarioResult {
  id        String           @id @default(cuid())
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  // JSON array of { name, level }
  scores    String
  createdAt DateTime         @default(now())
}

// ── Roles / openings ──────────────────────────────────────────────────────

model Company {
  id       String    @id @default(cuid())
  name     String
  location String
  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId  String
  openings Opening[]
}

model Opening {
  id                  String  @id @default(cuid())
  title               String
  industry            String
  company             Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId           String
  location            String
  salaryMin           Int?
  salaryMax           Int?
  currency            String  @default("€")
  hiringManagerName   String
  hiringManagerHeadline String
  hiringManagerInitials String
  // Employer-side privacy (per role, configurable at creation):
  //  • companyConfidential — hide the company identity from candidates
  //  • hmAnonymous — hide the hiring manager's real name
  // Masked values fall back to the *Alias strings (or a generic label), and are
  // revealed to a candidate only when the employer opts in (Match.employerRevealed).
  companyConfidential Boolean @default(false)
  hmAnonymous         Boolean @default(false)
  companyAlias        String?
  hiringManagerAlias  String?
  // JSON arrays of required skill names
  requiredHard        String  @default("[]")
  requiredSoft        String  @default("[]")
  // Priority matching (Scale plan): wider net + surfaced first.
  priority            Boolean @default(false)
  // Custom role calibration (Team plan): weight hard vs soft and set the pass bar.
  hardWeight          Int     @default(60)
  softWeight          Int     @default(40)
  passBar             Int     @default(60)
  // Per-skill importance (Team plan): JSON map skill → "essential"|"important"|"bonus".
  skillWeights        String  @default("{}")
  // Applied skill quiz (Scale plan): JSON of custom quiz items, if enabled.
  quiz                String?
  matches             Match[]
}

// ── The match (fit model) ─────────────────────────────────────────────────

model Match {
  id            String           @id @default(cuid())
  candidate     CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId   String
  opening       Opening          @relation(fields: [openingId], references: [id], onDelete: Cascade)
  openingId     String

  hardFit       Int
  softFit       Int
  mutualFit     Int
  verified      Boolean          @default(false)
  // JSON array of { skill, type, severity }
  gaps          String           @default("[]")
  candidateRank Int?
  poolSize      Int?

  // new | talking | offer | closed
  stage         String           @default("new")
  stageChangedAt DateTime        @default(now())
  candidateOptIn Boolean         @default(false)
  managerOptIn  Boolean          @default(false)
  saved         Boolean          @default(false)
  // Explicit, per-counterparty identity reveal (only when the person chooses).
  // candidateRevealed → the candidate showed their real identity to this employer.
  // employerRevealed  → the employer showed company/HM identity to this candidate.
  candidateRevealed Boolean      @default(false)
  employerRevealed  Boolean      @default(false)
  createdAt     DateTime         @default(now())

  thread       Thread?
  growthReport GrowthReport?
  feedback     FeedbackDraft?
  scoreSheets  ScoreSheet[]
  notes        PipelineNote[]

  @@unique([candidateId, openingId])
}

model Thread {
  id        String     @id @default(cuid())
  match     Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId   String     @unique
  createdAt DateTime   @default(now())
  messages  Message[]
  interview Interview?
}

model Message {
  id        String   @id @default(cuid())
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId  String
  from      User?    @relation(fields: [fromUserId], references: [id])
  fromUserId String?
  // Fallback label when the sender isn't a real user row (seed/HM persona)
  fromName  String
  text      String
  createdAt DateTime @default(now())
}

model Interview {
  id                String  @id @default(cuid())
  thread            Thread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId          String  @unique
  whenText          String
  // Real start time (when scheduled with a specific slot) — powers .ics export.
  whenAt            DateTime?
  medium            String  @default("video")
  scoreSheetAttached Boolean @default(false)
}

model GrowthReport {
  id                  String @id @default(cuid())
  match               Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId             String @unique
  roleTitle           String
  company             String
  hardYou             Int
  hardBar             Int
  softYou             Int
  softBar             Int
  primaryGapSkill     String
  primaryGapType      String
  rolesClearedIfClosed Int
  matchingProgramCount Int
  createdAt           DateTime @default(now())
}

model FeedbackDraft {
  id        String   @id @default(cuid())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId   String   @unique
  body      String
  sent      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Structured interview scorecard (Team plan).
model ScoreSheet {
  id             String   @id @default(cuid())
  match          Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId        String
  author         String
  // JSON array of { criterion, score } (score 1–5)
  ratings        String   @default("[]")
  overall        Int      @default(3)
  // strong_yes | yes | no | strong_no
  recommendation String   @default("yes")
  notes          String   @default("")
  createdAt      DateTime @default(now())
}

// Private hiring-manager note on a candidate (Team plan — full pipeline mgmt).
model PipelineNote {
  id        String   @id @default(cuid())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId   String
  author    String
  body      String
  createdAt DateTime @default(now())
}

// ── Recruiter ─────────────────────────────────────────────────────────────

model RecruiterIntro {
  id            String @id @default(cuid())
  recruiter     User   @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  recruiterId   String
  candidateName String
  roleTitle     String
  company       String
  valueNote     String
  // talking | interview | offer | hired
  stage         String @default("talking")
}

// ── Training provider + marketplace ───────────────────────────────────────

model Provider {
  id       String    @id @default(cuid())
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String    @unique
  name     String
  kind     String
  headline String
  initials String
  programs Program[]
}

model Program {
  id          String   @id @default(cuid())
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerId  String
  title       String
  format      String
  credential  String?
  // JSON array of tag strings
  tags        String   @default("[]")
  closesGap   String
  gapType     String
  sponsored   Boolean  @default(false)
  enrollments Int      @default(0)
  completions Int      @default(0)
  reMatches   Int      @default(0)

  enrollmentRows Enrollment[]
}

model Enrollment {
  id          String           @id @default(cuid())
  program     Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId   String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId String
  // enrolled | completed
  status      String           @default("enrolled")
  createdAt   DateTime         @default(now())

  @@unique([programId, candidateId])
}

// ── Billing ───────────────────────────────────────────────────────────────

model Subscription {
  id                   String  @id @default(cuid())
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String
  // which hat the plan is for: hiring_manager | provider
  hat                  String
  // plan key, e.g. hm-team, hm-scale, provider-partner
  plan                 String
  // active | trialing | canceled | incomplete
  status               String  @default("active")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?

  @@unique([userId, hat])
}
